<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Lintel</AssemblyName>
    <RootNamespace>Lintel</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Lintel</Product>
    <Description>A dynamic top-of-screen island for Windows 11.</Description>
    <ApplicationIcon>Assets\lintel.ico</ApplicationIcon>
    <Authors>Liviu Iorga</Authors>
    <Copyright>Copyright (c) 2026 Liviu Iorga</Copyright>
    <!-- WPF takes per-monitor DPI awareness from app.manifest; this WinForms hint doesn't apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Lightweight background app: no background GC thread, smaller heap reservations. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
