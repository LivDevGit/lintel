<Window x:Class="Lintel.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lintel Settings" Width="820" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
        Background="#F3F3F3" Foreground="#1A1A1A"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Accent" Color="#5B4BDB" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FBFBFB" />
            <Setter Property="BorderBrush" Value="#E3E3E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,4" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,12" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,24,0" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#ECECEC" />
            <Setter Property="Margin" Value="-18,0" />
        </Style>

        <!-- CheckBox restyled as a toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                    Background="Transparent" BorderBrush="#8A8A8A" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#5F5F5F"
                                         HorizontalAlignment="Left" Margin="4,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightCombo" TargetType="ComboBox">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="220" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="RightSlider" TargetType="Slider">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="220" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="56" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#555" />
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFFFFF" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F6F6F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Margin="0,1" Padding="12,9">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pip" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Accent}"
                                    HorizontalAlignment="Left" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EAEAEA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6E6E6" />
                                <Setter TargetName="Pip" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <DockPanel Margin="10,16,6,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,18">
                <Border Width="28" Height="28" CornerRadius="8" Background="#111">
                    <TextBlock Text="&#xE80A;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Lintel" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="OnNavChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Tag="PageGeneral"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE713;" VerticalAlignment="Center" /><TextBlock Text="General" Margin="12,0,0,0" /></StackPanel></ListBoxItem>
                <ListBoxItem Tag="PageIsland"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE790;" VerticalAlignment="Center" /><TextBlock Text="Island" Margin="12,0,0,0" /></StackPanel></ListBoxItem>
                <ListBoxItem Tag="PageMedia"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xEC4F;" VerticalAlignment="Center" /><TextBlock Text="Media" Margin="12,0,0,0" /></StackPanel></ListBoxItem>
                <ListBoxItem Tag="PageIndicators"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE995;" VerticalAlignment="Center" /><TextBlock Text="Indicators &amp; power" Margin="12,0,0,0" /></StackPanel></ListBoxItem>
                <ListBoxItem Tag="PageCalendar"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE787;" VerticalAlignment="Center" /><TextBlock Text="Calendar" Margin="12,0,0,0" /></StackPanel></ListBoxItem>
                <ListBoxItem Tag="PageShelf"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7B8;" VerticalAlignment="Center" /><TextBlock Text="Shelf" Margin="12,0,0,0" /></StackPanel></ListBoxItem>
                <ListBoxItem Tag="PageAbout"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE946;" VerticalAlignment="Center" /><TextBlock Text="About" Margin="12,0,0,0" /></StackPanel></ListBoxItem>
            </ListBox>
        </DockPanel>

        <ScrollViewer x:Name="Pages" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,28,20">
            <Grid MaxWidth="760">

                <!-- ======================= General ======================= -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtStartup}" />
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" Style="{StaticResource Label}" />
                                    <TextBlock Text="Launch Lintel automatically when you sign in." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Width="220" Padding="8,5" IsReadOnly="True"
                                         VerticalAlignment="Center" PreviewKeyDown="OnHotkeyKeyDown" Cursor="Hand"
                                         ToolTip="Click, then press the new shortcut" />
                                <StackPanel>
                                    <TextBlock Text="Open / close shortcut" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="HotkeyHint" Text="Click the box and press a key combination with Ctrl, Alt, Shift or Win." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="DisplayModeBox" Style="{StaticResource RightCombo}" SelectedItem="{Binding DisplayMode}" />
                                <StackPanel>
                                    <TextBlock Text="Where to show the island" Style="{StaticResource Label}" />
                                    <TextBlock Text="&quot;FollowCursor&quot; moves it to whichever display your pointer is on." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="DisplayBox" Style="{StaticResource RightCombo}" DisplayMemberPath="Label" SelectedValuePath="Device"
                                          SelectedValue="{Binding PreferredDisplay}" />
                                <StackPanel>
                                    <TextBlock Text="Specific display" Style="{StaticResource Label}" />
                                    <TextBlock Text="Used when the option above is set to Specific." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideInFullscreen}" />
                                <StackPanel>
                                    <TextBlock Text="Get out of the way of fullscreen apps" Style="{StaticResource Label}" />
                                    <TextBlock Text="Hide the island on a display while a game or video is fullscreen there." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideFromCapture}" />
                                <StackPanel>
                                    <TextBlock Text="Keep out of screenshots and recordings" Style="{StaticResource Label}" />
                                    <TextBlock Text="The island won't appear in screen captures, recordings or screen sharing." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= Island ======================= -->
                <StackPanel x:Name="PageIsland" Visibility="Collapsed">
                    <TextBlock Text="Island" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="StyleBox" Style="{StaticResource RightCombo}" SelectedItem="{Binding Style}" />
                                <StackPanel>
                                    <TextBlock Text="Shape" Style="{StaticResource Label}" />
                                    <TextBlock Text="Floating hovers just below the top edge. Attached hangs from the edge like a tab." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="TopEdgeBox" Style="{StaticResource RightCombo}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding TopEdge}" SelectionChanged="OnTopEdgeChanged" />
                                <StackPanel>
                                    <TextBlock Text="When an app is under the island" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="TopEdgeHint" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding CollapsedWidth, StringFormat={}{0:0} px}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="140" Maximum="320" TickFrequency="10" Value="{Binding CollapsedWidth}" />
                                <TextBlock Text="Resting width" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding CollapsedHeight, StringFormat={}{0:0} px}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="26" Maximum="40" TickFrequency="1" Value="{Binding CollapsedHeight}" />
                                <TextBlock Text="Resting height" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowShadow}" />
                                <TextBlock Text="Drop shadow when open" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OLED care" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="OLED panels can keep a faint image of anything that stays in one place for a long time." />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideWhenIdle}" />
                                <StackPanel>
                                    <TextBlock Text="Hide when idle" Style="{StaticResource Label}" />
                                    <TextBlock Text="Fade the island out when nothing is playing or happening. Move the pointer to the top edge to bring it back." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding IdleHideSeconds, StringFormat={}{0} s}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="2" Maximum="60" TickFrequency="1" Value="{Binding IdleHideSeconds}" />
                                <TextBlock Text="Hide after" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PixelShift}" />
                                <StackPanel>
                                    <TextBlock Text="Pixel shift" Style="{StaticResource Label}" />
                                    <TextBlock Text="Every few minutes, nudge the island a few pixels so its edges don't sit on the same pixels all day." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OpenOnHover}" />
                                <StackPanel>
                                    <TextBlock Text="Open when the pointer rests on it" Style="{StaticResource Label}" />
                                    <TextBlock Text="Turn off to open it only with a click or the shortcut." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding HoverDelayMs, StringFormat={}{0} ms}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="0" Maximum="1000" TickFrequency="20" Value="{Binding HoverDelayMs}" />
                                <TextBlock Text="Rest time before opening" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding CloseDelayMs, StringFormat={}{0} ms}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="100" Maximum="2000" TickFrequency="50" Value="{Binding CloseDelayMs}" />
                                <TextBlock Text="Grace period before closing" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScrollChangesVolume}" />
                                <StackPanel>
                                    <TextBlock Text="Scroll over the island to change volume" Style="{StaticResource Label}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RememberLastTab}" />
                                <TextBlock Text="Reopen on the last tab you used" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowClockWhenIdle}" />
                                <TextBlock Text="Show the time when nothing else is going on" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="AccentBox" Style="{StaticResource RightCombo}" SelectedItem="{Binding AccentMode}" />
                                <StackPanel>
                                    <TextBlock Text="Highlight colour" Style="{StaticResource Label}" />
                                    <TextBlock Text="AlbumArt picks a colour from whatever's playing, and falls back to your Windows accent." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <Border x:Name="Swatch" DockPanel.Dock="Right" Width="28" Height="28" CornerRadius="14" Margin="10,0,0,0"
                                        BorderBrush="#22000000" BorderThickness="1" />
                                <TextBox DockPanel.Dock="Right" Width="182" Padding="8,5" VerticalAlignment="Center"
                                         Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel>
                                    <TextBlock Text="Custom colour" Style="{StaticResource Label}" />
                                    <TextBlock Text="Hex, like #FF8A5CF6. Used when the option above is Custom." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= Media ======================= -->
                <StackPanel x:Name="PageMedia" Visibility="Collapsed">
                    <TextBlock Text="Media" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,-8,0,14"
                               Text="Lintel works with any app that shows up in the Windows media controls: Spotify, browsers, Media Player, VLC and more." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowMediaActivity}" />
                                <StackPanel>
                                    <TextBlock Text="Show what's playing on the closed island" Style="{StaticResource Label}" />
                                    <TextBlock Text="The pill widens to show album art and a visualizer." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowTitleInPill}" />
                                <TextBlock Text="Scroll the song title across the pill" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LiveVisualizer}" />
                                <StackPanel>
                                    <TextBlock Text="Live visualizer" Style="{StaticResource Label}" />
                                    <TextBlock Text="Bars react to the actual audio coming out of your speakers." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding PausedActivitySeconds, StringFormat={}{0} s}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="0" Maximum="120" TickFrequency="5" Value="{Binding PausedActivitySeconds}" />
                                <TextBlock Text="Keep showing after pause for" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowTrackPeek}" />
                                <StackPanel>
                                    <TextBlock Text="Announce new songs" Style="{StaticResource Label}" />
                                    <TextBlock Text="Briefly show the title and artist under the island when the track changes." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding PeekSeconds, StringFormat={}{0:0.0} s}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="1" Maximum="8" TickFrequency="0.5" Value="{Binding PeekSeconds}" />
                                <TextBlock Text="Announcement length" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= Indicators ======================= -->
                <StackPanel x:Name="PageIndicators" Visibility="Collapsed">
                    <TextBlock Text="Indicators &amp; power" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowVolumeHud}" />
                                <StackPanel>
                                    <TextBlock Text="Volume indicator" Style="{StaticResource Label}" />
                                    <TextBlock Text="Show the level on the island when the volume changes. The Windows flyout still appears too." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowBrightnessHud}" />
                                <StackPanel>
                                    <TextBlock Text="Brightness indicator" Style="{StaticResource Label}" />
                                    <TextBlock Text="Built-in laptop and tablet screens only." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowBattery}" />
                                <TextBlock Text="Show battery in the open island" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowBatteryPercent}" />
                                <TextBlock Text="Include the percentage" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PowerPeeks}" />
                                <StackPanel>
                                    <TextBlock Text="Power notices" Style="{StaticResource Label}" />
                                    <TextBlock Text="Plugging in, unplugging, low battery and energy saver." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding LowBatteryThreshold, StringFormat={}{0}%}" />
                                <Slider Style="{StaticResource RightSlider}" Minimum="5" Maximum="50" TickFrequency="5" Value="{Binding LowBatteryThreshold}" />
                                <TextBlock Text="Low battery warning at" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= Calendar ======================= -->
                <StackPanel x:Name="PageCalendar" Visibility="Collapsed">
                    <TextBlock Text="Calendar" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CalendarEnabled}" />
                                <TextBlock Text="Show today's agenda" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideAllDayEvents}" />
                                <TextBlock Text="Leave out all-day events" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Calendar links" Style="{StaticResource Label}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12">
                                Paste a private iCal (.ics) link. Google Calendar: Settings → your calendar → "Secret address in iCal format".
                                Outlook: Settings → Calendar → Shared calendars → Publish a calendar → ICS.
                                iCloud: share the calendar publicly and copy the webcal link.
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="Add" Margin="8,0,0,0" Click="OnAddFeed" />
                                <TextBox x:Name="FeedBox" Padding="8,5" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="FeedList" ItemsSource="{Binding CalendarFeeds}" Margin="0,10,0,0" MinHeight="60" MaxHeight="160"
                                     BorderBrush="#E3E3E3" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource Action}" Content="Remove selected" Click="OnRemoveFeed" />
                                <Button Style="{StaticResource Action}" Content="Refresh now" Click="OnRefreshFeeds" Margin="8,0,0,0" />
                                <TextBlock x:Name="FeedStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= Shelf ======================= -->
                <StackPanel x:Name="PageShelf" Visibility="Collapsed">
                    <TextBlock Text="Shelf" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,-8,0,14"
                               Text="Drag files, images, text or links onto the island to park them, then drag them out wherever you need them." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShelfEnabled}" />
                                <TextBlock Text="Enable the shelf" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OpenShelfWhenItems}" />
                                <TextBlock Text="Open straight to the shelf when it has something on it" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RemoveAfterDragOut}" />
                                <TextBlock Text="Take items off the shelf once they're dragged out" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WatchDownloads}" />
                                <StackPanel>
                                    <TextBlock Text="Watch the Downloads folder" Style="{StaticResource Label}" />
                                    <TextBlock Text="Show when a browser download is in progress and when it finishes." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AddDownloadsToShelf}" />
                                <TextBlock Text="Put finished downloads on the shelf" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= About ======================= -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="A dynamic island for the top of your Windows screen: music, indicators, your agenda and a drop shelf." />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Action}" Content="Open data folder" Click="OnOpenData" />
                                <Button Style="{StaticResource Action}" Content="Quit Lintel" Click="OnQuit" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
